<Window x:Class="BlockinLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blockin Launcher" Height="650" Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Button Style for Titlebar Controls -->
        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2D32"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button Style -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E9297"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F3136"/>
                                <Setter Property="Foreground" Value="#DCDDDE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Play Button Style -->
        <Style x:Key="BigPlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#228B22"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#32CD32" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E8B57"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF00"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006400"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#228B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Green Action Button Style -->
        <Style x:Key="GreenBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#43B581"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3CA374"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Layout -->
    <Grid>
        <Border x:Name="MainContainer" Background="#18191C" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/> <!-- Custom Titlebar -->
                    <RowDefinition Height="*"/>  <!-- Main Content -->
                    <RowDefinition Height="28"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- Custom Window Titlebar -->
                <Grid Grid.Row="0" Background="#202225" MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Blockin Launcher (insanestudios)" Foreground="#8E9297" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button Style="{StaticResource WindowBtnStyle}" Content="─" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeBtn" Style="{StaticResource WindowBtnStyle}" Content="🗖" Click="Maximize_Click"/>
                        <Button Style="{StaticResource WindowBtnStyle}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Main View Container -->
                <Grid Grid.Row="1">

                    <!-- GAME VIEW (With Image Background, Logo, & Big PLAY Button) -->
                    <Grid x:Name="GameView" Visibility="Visible">
                        <!-- Background Image Brush -->
                        <Grid.Background>
                            <ImageBrush ImageSource="/background.png" Stretch="UniformToFill" Opacity="0.8"/>
                        </Grid.Background>

                        <!-- Content Layout -->
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Logo Header -->
                                <RowDefinition Height="*"/>    <!-- Center Stage / Play Area -->
                                <RowDefinition Height="Auto"/> <!-- Bottom Controls / Console Overlay -->
                            </Grid.RowDefinitions>

                            <!-- Top Section: Game Logo -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Image Source="/logo.png" Height="100" Stretch="Uniform" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                
                                <TextBlock Text="BLOCKIN" Foreground="#FFD700" FontSize="36" FontWeight="Black" 
                                           HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Center Section: BIG PLAY BUTTON -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BigPlayButtonStyle}" Content="▶ PLAY" Click="RunButton_Click">
                                    <Button.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4"/>
                                    </Button.Effect>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Overlay: Navigation & Embedded Console -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Navigation Bar overlaying background -->
                                <Border Grid.Row="0" Background="#CC2F3136" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button Style="{StaticResource NavBtnStyle}" Content="Game" Click="NavGame_Click"/>
                                            <Button Style="{StaticResource NavBtnStyle}" Content="Settings" Click="NavSettings_Click"/>
                                            <Button x:Name="DebugNavBtn" Style="{StaticResource NavBtnStyle}" Content="Compiler Debug" Click="NavDebug_Click" Visibility="Collapsed"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button x:Name="BuildBtn" Style="{StaticResource GreenBtnStyle}" Content="Build Sources" Click="BuildButton_Click" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Console Drawer Overlay -->
                                <Border x:Name="GameConsoleContainer" Grid.Row="1" Background="#DD18191C" CornerRadius="8" Padding="10" Height="140" Visibility="Visible">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Launcher Output" Foreground="#8E9297" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>

                                        <ScrollViewer x:Name="ConsoleScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBox x:Name="ConsoleOutput" Background="Transparent" Foreground="#DCDDDE" 
                                                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" 
                                                     FontFamily="Consolas" FontSize="12"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- SETTINGS VIEW -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="20" Background="#2F3136">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource NavBtnStyle}" Content="Game" Click="NavGame_Click"/>
                                <Button Style="{StaticResource NavBtnStyle}" Content="Settings" Click="NavSettings_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Margin="10">
                                <TextBlock Text="Launcher &amp; Game Paths" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="Game Folder Path:" Foreground="#B9BBBE" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#202225" CornerRadius="4">
                                        <TextBox x:Name="GamePathTxt" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="8"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource GreenBtnStyle}" Margin="8,0,0,0" Click="BrowseGamePath_Click"/>
                                </Grid>

                                <TextBlock Text="Source Folder Path (.java):" Foreground="#B9BBBE" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#202225" CornerRadius="4">
                                        <TextBox x:Name="SourcePathTxt" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="8"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource GreenBtnStyle}" Margin="8,0,0,0" Click="BrowseSourcePath_Click"/>
                                </Grid>

                                <TextBlock Text="Build Output Path (.class):" Foreground="#B9BBBE" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#202225" CornerRadius="4">
                                        <TextBox x:Name="BuildPathTxt" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="8"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource GreenBtnStyle}" Margin="8,0,0,0" Click="BrowseBuildPath_Click"/>
                                </Grid>

                                <TextBlock Text="Natives Path:" Foreground="#B9BBBE" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#202225" CornerRadius="4">
                                        <TextBox x:Name="NativesPathTxt" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="8"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource GreenBtnStyle}" Margin="8,0,0,0" Click="BrowseNativesPath_Click"/>
                                </Grid>

                                <Separator Background="#40444B" Margin="0,10,0,15"/>

                                <TextBlock Text="Classpath Dependency JARs" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox x:Name="JarListBox" Height="90" Background="#202225" Foreground="#DCDDDE" BorderThickness="0" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#202225" CornerRadius="4">
                                        <TextBox x:Name="JarInputTxt" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="8"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource NavBtnStyle}" Margin="8,0,0,0" Click="BrowseJarFile_Click"/>
                                    <Button Grid.Column="2" Content="Add JAR" Style="{StaticResource GreenBtnStyle}" Margin="8,0,0,0" Click="AddJar_Click"/>
                                    <Button Grid.Column="3" Content="Remove Selected" Style="{StaticResource NavBtnStyle}" Margin="8,0,0,0" Click="RemoveJar_Click"/>
                                </Grid>

                                <Separator Background="#40444B" Margin="0,10,0,15"/>

                                <TextBlock Text="Launcher Configuration" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ShowConsoleChk" Content="Show Output Console on Game View" Foreground="#DCDDDE" IsChecked="True" Checked="ConsoleChk_Changed" Unchecked="ConsoleChk_Changed" Margin="0,0,0,8"/>
                                <CheckBox x:Name="EnableDebugChk" Content="Enable Compiler Debug View &amp; JVM Hacks" Foreground="#DCDDDE" IsChecked="False" Checked="DebugChk_Changed" Unchecked="DebugChk_Changed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- COMPILER DEBUG VIEW -->
                    <Grid x:Name="DebugView" Visibility="Collapsed" Margin="20" Background="#2F3136">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource NavBtnStyle}" Content="Game" Click="NavGame_Click"/>
                                <Button Style="{StaticResource NavBtnStyle}" Content="Settings" Click="NavSettings_Click"/>
                                <Button Style="{StaticResource NavBtnStyle}" Content="Compiler Debug" Click="NavDebug_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Background="#202225" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Verbose JAVAC Compilation &amp; Output Log" Foreground="#8E9297" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                                <ScrollViewer x:Name="DebugConsoleScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="DebugConsoleOutput" Background="Transparent" Foreground="#00FF00" 
                                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" 
                                             FontFamily="Consolas" FontSize="12"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- Bottom Status Bar -->
                <Grid Grid.Row="2" Background="#202225">
                    <TextBlock x:Name="StatusText" Text="Status: Ready" Foreground="#8E9297" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Invisible Win32 Resize Handles -->
        <Rectangle Tag="TopLeft" VerticalAlignment="Top" HorizontalAlignment="Left" Width="6" Height="6" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent"/>
        <Rectangle Tag="TopRight" VerticalAlignment="Top" HorizontalAlignment="Right" Width="6" Height="6" Cursor="SizeNESW" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent"/>
        <Rectangle Tag="BottomLeft" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="6" Height="6" Cursor="SizeNESW" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent"/>
        <Rectangle Tag="BottomRight" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="6" Height="6" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent"/>
        <Rectangle Tag="Top" VerticalAlignment="Top" Height="6" Cursor="SizeNS" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent" Margin="6,0"/>
        <Rectangle Tag="Bottom" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent" Margin="6,0"/>
        <Rectangle Tag="Left" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent" Margin="0,6"/>
        <Rectangle Tag="Right" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" PreviewMouseLeftButtonDown="Resize_Start" Fill="Transparent" Margin="0,6"/>
    </Grid>
</Window>